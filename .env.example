# Copy to .env and fill in.

# Database (Supabase): pooled connection for the app, direct one for migrations
DATABASE_URL=
DIRECT_URL=

# Secret used to sign login tokens (any long random string)
JWT_SECRET=

# Public address of the app, used in password-reset emails.
# Required in production, e.g. https://app.farmexpo.com
APP_URL=

# Outgoing email for password resets (any SMTP provider: Gmail with an app
# password, Outlook, Zoho, SendGrid, Mailgun, Amazon SES...).
# Without SMTP_HOST, reset links are only printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FarmExpo <no-reply@example.com>"
