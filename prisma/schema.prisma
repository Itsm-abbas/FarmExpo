// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Ownership: every top-level business record belongs to an Organization
// (`organizationId`) and records who created it (`userId`). Child records
// (Packer, Consignee, IATAAgent, CustomAgent, Transaction, ConsignmentItem,
// FinancialInstrumentUtilization) are scoped through their parent.
// See lib/session.js for how the scope and the role permissions are applied.

model Organization {
  id           Int     @id @default(autoincrement())
  name         String
  // Logo image as a data URL (png/jpeg/webp), served by /api/organization/logo.
  logo         String?
  email        String?
  phone        String?
  address      String?
  ntn          String?
  website      String?
  // Currency for consignment costs, invoices and new vendors.
  baseCurrency String  @default("PKR")
  // Hex color (#RRGGBB) used to theme the app for the organization.
  brandColor   String?

  // Invoice and statement PDFs: "classic" | "modern" | "compact".
  invoiceTemplate  String   @default("classic")
  // Letterhead page (data URL: PNG, JPEG or PDF), printed behind documents
  // when useLetterhead is on. Served by /api/organization/letterhead.
  letterhead       String?
  // MIME type of the letterhead ("image/png" | "image/jpeg" | "application/pdf"),
  // so its presence is known without loading it.
  letterheadType   String?
  useLetterhead    Boolean  @default(false)
  // Space (mm) kept clear at the top and bottom of the letterhead.
  letterheadTop    Int      @default(45)
  letterheadBottom Int      @default(30)
  // Printed at the end of invoices, e.g. bank details or terms.
  invoiceNotes     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users User[]
}

model User {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  password       String
  name           String?
  // "admin": full access. "user": staff with limited access (see lib/session.js).
  role           String        @default("user")
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  createdById    Int?
  createdBy      User?         @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers   User[]        @relation("CreatedUsers")

  // Password reset: SHA-256 of the emailed token, and when it stops working.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  // Sessions issued before this moment are rejected.
  passwordChangedAt   DateTime?

  @@index([organizationId])
}

model Trader {
  id                   Int                   @id @default(autoincrement())
  userId               Int?
  organizationId       Int?
  name                 String
  ntn                  String
  address              String
  country              String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  financialInstruments FinancialInstrument[]
  consignments         Consignment[]
  // Ledger account for what we owe the trader (e.g. a farmer we buy from).
  // Created with the first purchase recorded from them.
  vendorId             Int?                  @unique
  vendor               Vendor?               @relation(fields: [vendorId], references: [id])
  purchases            Purchase[]

  @@index([userId])
  @@index([organizationId])
}

model Commodity {
  id             Int      @id @default(autoincrement())
  userId         Int?
  organizationId Int?
  name           String
  number         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consignmentItems ConsignmentItem[]
  purchases        Purchase[]

  @@index([userId])
  @@index([organizationId])
}

model Vendor {
  id             Int      @id @default(autoincrement())
  userId         Int?
  organizationId Int?
  name           String
  ntn            String
  address        String
  country        String
  station        String
  // Balance the vendor started with, before any ledger transaction.
  openingBalance Float    @default(0)
  // Running balance = openingBalance + credits - debits. Maintained by lib/ledger.js.
  balance        Float?
  currency       String
  createdAt      DateTime @default(now())

  packer       Packer[]
  consignee    Consignee[]
  iataAgent    IATAAgent[]
  customAgent  CustomAgent[]
  trader       Trader?
  transactions Transaction[]

  @@index([userId])
  @@index([organizationId])
}

model Transaction {
  id            Int          @id @default(autoincrement())
  vendor        Vendor       @relation(fields: [vendorId], references: [id])
  vendorId      Int
  voucherId     String
  transactionId String
  type          String // "credit" or "debit"
  amount        Float
  details       String?
  createdBy     Int? // user who created this
  balanceAfter  Float // vendor balance immediately after this txn
  consignmentId Int?
  consignment   Consignment? @relation(fields: [consignmentId], references: [id])
  purchaseId    Int?
  purchase      Purchase?    @relation(fields: [purchaseId], references: [id])
  // Set for entries posted automatically from a consignment
  // ("airwayBill" | "customClearance" | "packing" | "consignee" | "recovery")
  // or a purchase ("purchase"). Null for entries added manually on the ledger page.
  source        String?
  createdAt     DateTime     @default(now())

  @@index([vendorId])
  @@index([consignmentId])
  @@index([purchaseId])
}

// Produce bought from a trader or farmer. Each purchase posts what we owe
// them to their ledger, and the daily price list averages purchases per day.
model Purchase {
  id             Int       @id @default(autoincrement())
  userId         Int?
  organizationId Int?
  // The day of the purchase (midnight UTC).
  date           DateTime
  traderId       Int
  trader         Trader    @relation(fields: [traderId], references: [id])
  commodityId    Int
  commodity      Commodity @relation(fields: [commodityId], references: [id])
  // Kilograms bought.
  quantity       Float
  // Price per kg, in the organization's base currency.
  rate           Float
  // quantity x rate, rounded to 2 decimals.
  amount         Float
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  transactions Transaction[]

  @@index([organizationId, date])
  @@index([userId])
  @@index([traderId])
  @@index([commodityId])
}

model Packer {
  id        Int       @id @default(autoincrement())
  vendorId  Int
  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  createdAt DateTime  @default(now())
  packing   Packing[]
}

model Consignee {
  id        Int      @id @default(autoincrement())
  vendorId  Int
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  balance   Float?
  createdAt DateTime @default(now())

  consignments        Consignment[]
  FinancialInstrument FinancialInstrument[]
}

model IATAAgent {
  id          Int          @id @default(autoincrement())
  vendorId    Int
  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  createdAt   DateTime     @default(now())
  airwayBills AirwayBill[]
}

model CustomAgent {
  id        Int      @id @default(autoincrement())
  vendorId  Int
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  createdAt DateTime @default(now())

  clearances CustomClearance[]
}

model Packaging {
  id                     Int      @id @default(autoincrement())
  userId                 Int?
  organizationId         Int?
  name                   String
  packagingWeightPerUnit String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  consignmentItems ConsignmentItem[]

  @@index([userId])
  @@index([organizationId])
}

model GoodsDeclaration {
  id                      Int       @id @default(autoincrement())
  userId                  Int?
  organizationId          Int?
  number                  String
  date                    DateTime
  exchangeRate            Float
  commercialInvoiceNumber String
  fob                     Float
  gdFreight               Float
  r1                      Float?
  dateR1                  DateTime?
  r2                      Float?
  dateR2                  DateTime?
  r3                      Float?
  dateR3                  DateTime?
  r4                      Float?
  dateR4                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  consignments Consignment[]
  Utilization  FinancialInstrumentUtilization[]

  @@index([userId])
  @@index([organizationId])
}

model Packing {
  id             Int      @id @default(autoincrement())
  userId         Int?
  organizationId Int?
  packerId       Int
  ratePerKg      Float
  totalCost      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  packer       Packer        @relation(fields: [packerId], references: [id])
  consignments Consignment[]

  @@index([userId])
  @@index([organizationId])
}

model RecoveryDone {
  id             Int           @id @default(autoincrement())
  userId         Int?
  organizationId Int?
  amount         Float
  currency       String
  exchangeRate   Float
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  consignments   Consignment[]

  @@index([userId])
  @@index([organizationId])
}

model AirwayBill {
  id               Int      @id @default(autoincrement())
  userId           Int?
  organizationId   Int?
  number           String
  iataAgentId      Int
  dateTime         DateTime
  rate             Float
  airwayBillWeight Float
  fee              Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  iataAgent IATAAgent @relation(fields: [iataAgentId], references: [id])

  consignments Consignment[]

  @@index([userId])
  @@index([organizationId])
}

model CustomClearance {
  id             Int      @id @default(autoincrement())
  userId         Int?
  organizationId Int?
  customAgentId  Int
  fee            Float
  totalCost      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customAgent  CustomAgent   @relation(fields: [customAgentId], references: [id])
  consignments Consignment[]

  @@index([userId])
  @@index([organizationId])
}

model FinancialInstrument {
  id             Int       @id @default(autoincrement())
  userId         Int?
  organizationId Int?
  number         String
  traderId       Int?
  bankName       String?
  mode           String?
  consigneeId    Int?
  deliveryTerm   String?
  currency       String?
  localDate      DateTime?
  expiryDate     DateTime?
  status         String?
  amount         Float     @default(0)
  balance        Float     @default(0)
  iban           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  trader       Trader?                          @relation(fields: [traderId], references: [id])
  consignee    Consignee?                       @relation(fields: [consigneeId], references: [id])
  utilizations FinancialInstrumentUtilization[]

  @@index([userId])
  @@index([organizationId])
}

model FinancialInstrumentUtilization {
  id                    Int      @id @default(autoincrement())
  financialInstrumentId Int
  goodsDeclarationId    Int
  utilized              Float
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  financialInstrument FinancialInstrument @relation(fields: [financialInstrumentId], references: [id])
  goodsDeclaration    GoodsDeclaration    @relation(fields: [goodsDeclarationId], references: [id])
}

model ConsignmentItem {
  id                   Int   @id @default(autoincrement())
  consignmentId        Int
  commodityItemId      Int
  packagingId          Int
  weightPerUnit        Float
  commodityPerUnitCost Float
  packagingPerUnitCost Float
  quantity             Int
  damage               Int

  consignment   Consignment @relation(fields: [consignmentId], references: [id])
  commodityItem Commodity   @relation(fields: [commodityItemId], references: [id])
  packaging     Packaging   @relation(fields: [packagingId], references: [id])
}

model Consignment {
  id                 Int  @id @default(autoincrement())
  userId             Int?
  organizationId     Int?
  traderId           Int?
  consigneeId        Int?
  airwayBillId       Int?
  goodsDeclarationId Int?
  customClearanceId  Int?
  packingId          Int?
  recoveryDoneId     Int?

  date               DateTime
  localInvoiceWeight Float?
  dailyExpenses      Float?
  // Amount billed to the consignee for this consignment (posted to their ledger).
  consigneeAmount    Float?
  status             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  trader           Trader?           @relation(fields: [traderId], references: [id])
  consignee        Consignee?        @relation(fields: [consigneeId], references: [id])
  airwayBill       AirwayBill?       @relation(fields: [airwayBillId], references: [id])
  goodsDeclaration GoodsDeclaration? @relation(fields: [goodsDeclarationId], references: [id])
  customClearance  CustomClearance?  @relation(fields: [customClearanceId], references: [id])
  packing          Packing?          @relation(fields: [packingId], references: [id])
  recoveryDone     RecoveryDone?     @relation(fields: [recoveryDoneId], references: [id])

  goods       ConsignmentItem[]
  Transaction Transaction[]

  @@index([userId])
  @@index([organizationId])
}
